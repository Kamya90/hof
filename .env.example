# HOF — Environment Variables
# Copy this to .env and fill in your keys
# NEVER commit .env to GitHub

# ── AI — Gemini handles BOTH framing and embeddings ───────────────
# Free. No credit card. Get at: aistudio.google.com → Get API Key
GEMINI_API_KEY=your_gemini_key_here

# ── DATABASE ───────────────────────────────────────────────────────
# Free tier. Get at: supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── NEWS SOURCES ───────────────────────────────────────────────────
# Free (100 req/day). Get at: newsapi.org
NEWSAPI_KEY=your_newsapi_key_here

# Reddit — Free. Get at: reddit.com/prefs/apps → Create App → Script
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=hof-bot/1.0

# ── PIPELINE CONFIG ────────────────────────────────────────────────
MAX_STORIES_PER_RUN=12
MIN_SCORE_THRESHOLD=25.0
